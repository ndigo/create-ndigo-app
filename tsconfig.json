{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "inlineSourceMap": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "lib": ["ES2024"],
    "strict": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": ".tscache"
  },
  "include": ["src/**/*"]
}